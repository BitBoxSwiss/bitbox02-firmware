#!/usr/bin/env bash

set -euo pipefail

# Disallow symbols in the final linked ELF that indicate expensive code paths.
failed=0
checked=0

check_symbols() {
    local elf=$1
    local name=$2
    local pattern=$3
    shift 3

    local symbols
    symbols=$(arm-none-eabi-nm -C "$elf")

    local matches
    matches=$(grep -E "$pattern" <<<"$symbols" || true)
    if [[ -z "$matches" ]]; then
        return
    fi

    echo "Found unwanted symbols for: $name in $elf" >&2
    echo "$matches" | sed -n '1,20p' >&2
    for line in "$@"; do
        echo "$line" >&2
    done
    echo >&2
    failed=1
}

check_firmware() {
    local elf=$1
    checked=1

    check_symbols \
        "$elf" \
        "Rust float formatting" \
        "float_to_decimal_common_shortest" \
        "Rust fmt float formatting like {:.1} adds significant binary bloat." \
        "Use integer arithmetic and format the resulting integer parts explicitly."

    check_symbols \
        "$elf" \
        "floating-point remainder" \
        "(^|::|[[:space:]])fmodf?($|::|[.[:space:]])" \
        "Floating-point remainder adds significant binary bloat." \
        "Avoid floating-point % and round via integer conversion, as in format_percentage()."

    check_symbols \
        "$elf" \
        "strftime" \
        "(^|[[:space:]])strftime($|[[:space:]])" \
        "strftime adds significant binary bloat." \
        "Use custom formatting like in format_datetime()."

    check_symbols \
        "$elf" \
        "RustCrypto SHA-256" \
        "sha26sha256|sha2::(sha256::|core_api::Sha256VarCore|OidSha256)" \
        "RustCrypto SHA-256 duplicates the bitcoin_hashes backend already linked in firmware." \
        "Use util::sha256::Sha256 or bitcoin::hashes::sha256 instead."

    check_symbols \
        "$elf" \
        "sha2::Sha512" \
        "sha26sha512|sha2::sha512" \
        "sha2::Sha512 adds significant binary bloat." \
        "Only use it if there is no other sha512 implementation available that is smaller."

    check_symbols \
        "$elf" \
        "software f32 arithmetic helpers" \
        "(__aeabi_f(add|sub|mul|div)|__(add|sub|mul|div|neg)sf3|compiler_builtins::float::(add|sub|mul|div)::.*f32)" \
        "Software f32 arithmetic helpers add significant binary bloat." \
        "Use integer arithmetic in firmware code instead."

    check_symbols \
        "$elf" \
        "num-bigint decimal formatting" \
        "num_bigint::(biguint::BigUint|bigint::BigInt).*(to_str_radix|as core::fmt::Display)" \
        "Generic BigUint/BigInt decimal formatting pulls in large-number arithmetic." \
        "Use the util::decimal helpers instead."

    check_symbols \
        "$elf" \
        "num-bigint general multiplication and division" \
        "num_bigint::biguint::(multiplication::(mac3|mul3)|division::div_rem_core)" \
        "General BigUint multiplication and division add significant binary bloat." \
        "Use scalar arithmetic where possible, as in Ethereum's parse_fee()."
}

check_bootloader() {
    local elf=$1
    checked=1

    local printf_symbol_pattern
    printf_symbol_pattern='(^|[[:space:]])(_?(asiprintf|asnprintf|asprintf|fprintf|iprintf|printf|siprintf|sniprintf|snprintf|sprintf|vasiprintf|vasnprintf|vasprintf|vfprintf|vfiprintf|vprintf|vsiprintf|vsniprintf|vsnprintf|vsprintf)(_r)?|_printf_common|_printf_i|_svfprintf_r|_svfiprintf_r|__sprint_r|__ssputs_r)([.$[:space:]]|$)'
    check_symbols \
        "$elf" \
        "stdio formatting" \
        "$printf_symbol_pattern" \
        "snprintf/printf pulls in significant bootloader bloat." \
        "Avoid stdio formatting in bootloaders; use fixed-format helpers instead."

    local rust_fmt_symbol_pattern
    rust_fmt_symbol_pattern='(^|[[:space:]])(alloc::fmt::|core::fmt::|<alloc::string::String as core::fmt::Write>)'
    check_symbols \
        "$elf" \
        "Rust formatting" \
        "$rust_fmt_symbol_pattern" \
        "Rust format!/write! formatting pulls in significant bootloader bloat." \
        "Avoid Rust formatting in bootloaders; use fixed-format helpers instead."

    check_symbols \
        "$elf" \
        "Rust SHA-256" \
        "sha26sha256|sha2::sha256::compress256" \
        "The RustCrypto SHA-256 implementation pulls in significant bootloader bloat." \
        "Use the existing PUKCC SHA-256 implementation in bootloaders instead."
}

shopt -s nullglob
for firmware_elf in build-bitbox02*-cmake-*/bin/firmware.elf build-bitbox02*-cmake-*/bin/firmware-btc.elf; do
    check_firmware "$firmware_elf"
done

for bootloader_elf in build-bitbox02*-cmake-*/bin/bootloader-stage0-*.elf build-bitbox02*-cmake-*/bin/bootloader-stage1-*.elf; do
    check_bootloader "$bootloader_elf"
done
shopt -u nullglob

if [[ "$checked" == 0 ]]; then
    echo "No checked ELF files found in build-bitbox02*-cmake-*/bin" >&2
    exit 2
fi

exit "$failed"
