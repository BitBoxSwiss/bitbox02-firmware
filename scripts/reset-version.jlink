h
// Always preserve the other bytes in the erase block.
exec SetFlashDLNoRMWThreshold = 0xFFFFFFFF
mem 0xf8004 4
// signing keys v1
w4 0xf8004 0x00000001
mem 0xf8004 4
mem 0xf8188 4
// fw monotonic version 1
w4 0xf8188 0x00000001
mem 0xf8188 4
// SHA256(signing keys v1 little-endian || firmware v1 little-endian)
loadfile scripts/reset-version-hash.bin 0xf824d noreset
mem 0xf824d 0x20
q
